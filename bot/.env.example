# Discord
DISCORD_WEBHOOK_URL=

# Protocol: sftp or ftp
PROTOCOL=ftp
REMOTE_PATH=script-output/telemetry.jsonl
POLL_SECONDS=15

# SFTP (if PROTOCOL=sftp)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_KEY_PATH=

# FTP (if PROTOCOL=ftp)
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=

# Quiet hours / ping
TIMEZONE=Europe/Warsaw
QUIET_HOURS_START=23:00
QUIET_HOURS_END=08:00
PING_ROLE_ID=
PING_ON_JOIN=false
PING_ON_CRITICAL_ONLY=true

# AFK
AFK_ON_SECONDS=300
AFK_OFF_SECONDS=60